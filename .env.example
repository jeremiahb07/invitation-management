# Copy to .env and fill in. .env is gitignored; this example file is not.
# Later build-plan items append their own vars here (Resend, admin auth, BASE_URL).

# MongoDB connection string. Required; the server exits if it cannot connect.
# Local:  mongodb://127.0.0.1:27017/invitation
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/invitation?retryWrites=true&w=majority
MONGODB_URI=

# Optional. Render supplies its own; the server falls back to 3000.
PORT=3000
